rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /leaderboards/{docId} {
      allow read: if true;
      allow write: if false; // Leaderboard data is written from server-side logic or secured functions
    }
  }
}
