func _ready() -> void:
	if GameState:
		if GameState.has_signal("biome_changed"):
			GameState.biome_changed.connect(_on_biome_changed)

func _process(delta: float) -> void:
	if transition_weight < 1.0:
		transition_weight = min(1.0, transition_weight + delta * 0.85)

func _on_biome_changed(new_idx: int) -> void:
	if new_idx != target_biome_idx:
		current_biome_idx = target_biome_idx
		target_biome_idx = new_idx
		transition_weight = 0.0

func set_biome_direct(idx: int) -> void:
	current_biome_idx = idx
	target_biome_idx = idx
	transition_weight = 1.0

func _get_raw_biome_height(b_idx: int, local_x: int) -> float:
	match b_idx:
		0:
			return JUNGLE_HEIGHTS[local_x]
		1:
			return VOLCANO_HEIGHTS[local_x]
		2:
			return STARLIGHT_HEIGHTS[local_x]
		3:
			return GLACIER_HEIGHTS[local_x]
		_:
			return JUNGLE_HEIGHTS[local_x]

func get_height_at_world_x(screen_x: float, scroll_offset_x: float) -> float:
	var local_x = posmod(int(screen_x - scroll_offset_x), GROUND_WIDTH)
	var h_from = _get_raw_biome_height(current_biome_idx, local_x)
	var h_to = _get_raw_biome_height(target_biome_idx, local_x)
	return lerp(h_from, h_to, transition_weight)

func get_slope_angle(screen_x: float, scroll_offset_x: float) -> float:
	var x1 = screen_x - 12.0
	var x2 = screen_x + 12.0
	var y1 = get_height_at_world_x(x1, scroll_offset_x)
	var y2 = get_height_at_world_x(x2, scroll_offset_x)
	return atan2(y2 - y1, 24.0)
